# Copy to .env and fill values before running locally

# PostgreSQL connection string (Vercel Postgres / Neon / Supabase all work)
# Example (Vercel Postgres):
# DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require"
DATABASE_URL=""

# Same database without connection pooling (on Neon: drop "-pooler" from the host).
# Used by prisma migrate, which times out through the pooler.
DIRECT_URL=""

# 32+ chars secret for iron-session cookie encryption
# Generate one: openssl rand -base64 32
IRON_SESSION_PASSWORD=""
